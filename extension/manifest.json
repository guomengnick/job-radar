{
  "manifest_version": 3,
  "name": "送到雷達",
  "version": "1.4.0",
  "description": "把職缺頁送到 job-radar 評分，結果由 Telegram 回覆：目前這一頁，或一次送出所有開著的 104 職缺；也能一次開啟 104 配對信裡的職缺，或從 Telegram 連結帶入 104 應徵表單（由你自己送出）。",
  "action": { "default_title": "送到雷達", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://www.104.com.tw/job/*"], "js": ["apply.js"], "run_at": "document_start" }],
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://*.lambda-url.ap-southeast-2.on.aws/*", "https://www.104.com.tw/*"]
}
